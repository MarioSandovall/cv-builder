root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
end_of_line = crlf
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{json,yml,yaml,ts,tsx,js,jsx,html,css,md}]
indent_size = 2

[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab
