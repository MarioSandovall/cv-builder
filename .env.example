# CV Builder — environment variables (template)
#
# Copy this file to `.env` (which is git-ignored) and keep it on your machine only.
#
# WARNING: The values below are intended for LOCAL DEVELOPMENT ONLY.
# They are weak, well-known, and committed in plaintext in this template.
# NEVER use these credentials in production, staging, shared, or
# publicly-accessible environments. Generate strong, unique secrets for
# any non-local deployment and store them in a proper secret manager.

POSTGRES_USER=cvbuilder
POSTGRES_PASSWORD=cvbuilder_dev
POSTGRES_DB=cvbuilder
POSTGRES_PORT=5432
